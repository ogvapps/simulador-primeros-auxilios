rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles & Progress:
    // Allow read for authenticated users (required for leaderboard and teacher views)
    // Allow write only for owner or administrators
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }

    // Student Summaries (Leaderboard):
    // Allow read only for authenticated students and teachers to prevent external scraping of minor student profiles
    // Write permitted only for the owner of the summary or administrators
    match /artifacts/{appId}/public/data/user_summaries/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }

    // Public configurations and surprise exams
    match /artifacts/{appId}/public/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
